model ShippingService {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id       String              @db.Uuid
  code             String              @db.VarChar(64)
  name             String              @db.VarChar(120)
  service_type     ShippingServiceType @default(surface)
  is_cod_supported Boolean             @default(false)
  is_international Boolean             @default(false)
  status           RecordStatus        @default(active)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?           @db.Timestamptz(6)
  created_by       String?             @db.Uuid
  updated_by       String?             @db.Uuid

  partner           ShippingPartner    @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  rate_cards        ShippingRateCard[]
  rules             ShippingRule[]
  shipments         Shipment[]
  reverse_shipments ReverseShipment[]

  @@index([partner_id], map: "idx_shipping_services_partner_id")
  @@map("shipping_services")
}

model ShippingZone {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String       @db.VarChar(64)
  name            String       @db.VarChar(120)
  country         String       @default("India") @db.VarChar(100)
  pincode_from    String?      @db.VarChar(20)
  pincode_to      String?      @db.VarChar(20)
  conditions_json Json?
  status          RecordStatus @default(active)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?    @db.Timestamptz(6)
  created_by      String?      @db.Uuid
  updated_by      String?      @db.Uuid

  rates_from ShippingRate[] @relation("RateFromZone")
  rates_to   ShippingRate[] @relation("RateToZone")

  @@map("shipping_zones")
}

model ShippingRateCard {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id     String       @db.Uuid
  service_id     String?      @db.Uuid
  name           String       @db.VarChar(120)
  currency       String       @default("INR") @db.VarChar(3)
  effective_from DateTime     @db.Date
  effective_to   DateTime?    @db.Date
  status         RecordStatus @default(active)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?    @db.Timestamptz(6)
  created_by     String?      @db.Uuid
  updated_by     String?      @db.Uuid

  partner ShippingPartner  @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  service ShippingService? @relation(fields: [service_id], references: [id], onDelete: SetNull)
  rates   ShippingRate[]

  @@index([partner_id], map: "idx_shipping_rate_cards_partner_id")
  @@map("shipping_rate_cards")
}

model ShippingRate {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rate_card_id  String       @db.Uuid
  from_zone_id  String?      @db.Uuid
  to_zone_id    String?      @db.Uuid
  min_weight_kg Decimal      @default(0) @db.Decimal(10, 3)
  max_weight_kg Decimal?     @db.Decimal(10, 3)
  base_rate     Decimal      @db.Decimal(12, 2)
  per_kg_rate   Decimal      @default(0) @db.Decimal(12, 2)
  currency      String       @default("INR") @db.VarChar(3)
  status        RecordStatus @default(active)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?    @db.Timestamptz(6)
  created_by    String?      @db.Uuid
  updated_by    String?      @db.Uuid

  rate_card ShippingRateCard @relation(fields: [rate_card_id], references: [id], onDelete: Cascade)
  from_zone ShippingZone?    @relation("RateFromZone", fields: [from_zone_id], references: [id], onDelete: SetNull)
  to_zone   ShippingZone?    @relation("RateToZone", fields: [to_zone_id], references: [id], onDelete: SetNull)

  @@index([rate_card_id], map: "idx_shipping_rates_rate_card_id")
  @@map("shipping_rates")
}

model ShippingRule {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String       @db.VarChar(120)
  priority        Int          @default(100)
  warehouse_id    String?      @db.Uuid
  partner_id      String       @db.Uuid
  service_id      String?      @db.Uuid
  conditions_json Json?
  status          RecordStatus @default(active)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?    @db.Timestamptz(6)
  created_by      String?      @db.Uuid
  updated_by      String?      @db.Uuid

  warehouse Warehouse?       @relation(fields: [warehouse_id], references: [id], onDelete: SetNull)
  partner   ShippingPartner  @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  service   ShippingService? @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([partner_id], map: "idx_shipping_rules_partner_id")
  @@index([warehouse_id], map: "idx_shipping_rules_warehouse_id")
  @@map("shipping_rules")
}

model PickupSchedule {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouse_id String       @db.Uuid
  partner_id   String       @db.Uuid
  day_of_week  Int
  window_start DateTime     @db.Time(6)
  window_end   DateTime     @db.Time(6)
  status       RecordStatus @default(active)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)
  created_by   String?      @db.Uuid
  updated_by   String?      @db.Uuid

  warehouse Warehouse       @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  partner   ShippingPartner @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  requests  PickupRequest[]

  @@index([warehouse_id], map: "idx_pickup_schedules_warehouse_id")
  @@index([partner_id], map: "idx_pickup_schedules_partner_id")
  @@map("pickup_schedules")
}

model PickupRequest {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouse_id       String       @db.Uuid
  partner_id         String       @db.Uuid
  pickup_schedule_id String?      @db.Uuid
  partner_pickup_ref String?      @db.VarChar(128)
  scheduled_at       DateTime?    @db.Timestamptz(6)
  picked_up_at       DateTime?    @db.Timestamptz(6)
  package_count      Int          @default(1)
  status             PickupStatus @default(requested)
  notes              String?      @db.Text
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?    @db.Timestamptz(6)
  created_by         String?      @db.Uuid
  updated_by         String?      @db.Uuid

  warehouse       Warehouse        @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  partner         ShippingPartner  @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  pickup_schedule PickupSchedule?  @relation(fields: [pickup_schedule_id], references: [id], onDelete: SetNull)
  shipments       Shipment[]

  @@index([warehouse_id], map: "idx_pickup_requests_warehouse_id")
  @@index([partner_id], map: "idx_pickup_requests_partner_id")
  @@index([status], map: "idx_pickup_requests_status")
  @@map("pickup_requests")
}

model Shipment {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_number       String         @db.VarChar(64)
  order_id              String         @db.Uuid
  fulfillment_order_id  String?        @db.Uuid
  warehouse_id          String         @db.Uuid
  partner_id            String         @db.Uuid
  service_id            String?        @db.Uuid
  pickup_request_id     String?        @db.Uuid
  shipping_address_id   String?        @db.Uuid
  pickup_point_id       String?        @db.Uuid
  tracking_number       String?        @db.VarChar(128)
  awb_number            String?        @db.VarChar(128)
  partner_shipment_ref  String?        @db.VarChar(128)
  currency              String         @default("INR") @db.VarChar(3)
  shipping_charge       Decimal        @default(0) @db.Decimal(12, 2)
  declared_value        Decimal?       @db.Decimal(14, 2)
  total_weight_kg       Decimal?       @db.Decimal(10, 3)
  volumetric_weight_kg  Decimal?       @db.Decimal(10, 3)
  status                ShipmentStatus @default(created)
  packed_at             DateTime?      @db.Timestamptz(6)
  dispatched_at         DateTime?      @db.Timestamptz(6)
  delivered_at          DateTime?      @db.Timestamptz(6)
  estimated_delivery_at DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime?      @db.Timestamptz(6)
  created_by            String?        @db.Uuid
  updated_by            String?        @db.Uuid

  order              Order              @relation(fields: [order_id], references: [id], onDelete: Restrict)
  fulfillment_order  FulfillmentOrder?  @relation(fields: [fulfillment_order_id], references: [id], onDelete: SetNull)
  warehouse          Warehouse          @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  partner            ShippingPartner    @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  service            ShippingService?   @relation(fields: [service_id], references: [id], onDelete: SetNull)
  pickup_request     PickupRequest?     @relation(fields: [pickup_request_id], references: [id], onDelete: SetNull)
  shipping_address   OrderAddress?      @relation(fields: [shipping_address_id], references: [id], onDelete: SetNull)
  packages           ShipmentPackage[]
  items              ShipmentItem[]
  labels             ShipmentLabel[]
  awb_numbers        AwbNumber[]
  tracking           ShipmentTracking?
  tracking_events    TrackingEvent[]
  delivery_attempts  DeliveryAttempt[]
  delivery_proofs    DeliveryProof[]
  reverse_shipments  ReverseShipment[]
  rto_forwards       RtoShipment[]      @relation("RtoForwardShipment")
  webhooks           ShippingWebhook[]
  insurance          ShipmentInsurance?
  delivery_slots     DeliverySlot[]
  cost_breakdown     ShippingCostBreakdown?
  eta_history        ShipmentEtaHistory[]
  pickup_point       PickupPoint?       @relation(fields: [pickup_point_id], references: [id], onDelete: SetNull)

  @@index([order_id], map: "idx_shipments_order_id")
  @@index([warehouse_id], map: "idx_shipments_warehouse_id")
  @@index([partner_id], map: "idx_shipments_partner_id")
  @@index([status], map: "idx_shipments_status")
  @@index([created_at], map: "idx_shipments_created_at")
  @@index([tracking_number], map: "idx_shipments_tracking_number")
  @@index([awb_number], map: "idx_shipments_awb_number")
  @@index([pickup_point_id], map: "idx_shipments_pickup_point_id")
  @@map("shipments")
}

model ShipmentPackage {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id          String       @db.Uuid
  package_number       String       @db.VarChar(64)
  length_cm            Decimal?     @db.Decimal(10, 2)
  width_cm             Decimal?     @db.Decimal(10, 2)
  height_cm            Decimal?     @db.Decimal(10, 2)
  weight_kg            Decimal      @db.Decimal(10, 3)
  volumetric_weight_kg Decimal?     @db.Decimal(10, 3)
  declared_value       Decimal?     @db.Decimal(14, 2)
  status               RecordStatus @default(active)
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?    @db.Timestamptz(6)
  created_by           String?      @db.Uuid
  updated_by           String?      @db.Uuid

  shipment Shipment        @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  items    ShipmentItem[]
  labels   ShipmentLabel[]

  @@index([shipment_id], map: "idx_shipment_packages_shipment_id")
  @@map("shipment_packages")
}

model ShipmentItem {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id   String       @db.Uuid
  order_item_id String       @db.Uuid
  package_id    String?      @db.Uuid
  quantity      Int
  status        RecordStatus @default(active)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?    @db.Timestamptz(6)
  created_by    String?      @db.Uuid
  updated_by    String?      @db.Uuid

  shipment   Shipment         @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  order_item OrderItem        @relation(fields: [order_item_id], references: [id], onDelete: Restrict)
  package    ShipmentPackage? @relation(fields: [package_id], references: [id], onDelete: SetNull)

  @@index([shipment_id], map: "idx_shipment_items_shipment_id")
  @@index([order_item_id], map: "idx_shipment_items_order_item_id")
  @@map("shipment_items")
}

model AwbNumber {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id  String    @db.Uuid
  awb_number  String    @db.VarChar(128)
  shipment_id String?   @db.Uuid
  assigned_at DateTime? @db.Timestamptz(6)
  status      AwbStatus @default(available)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid

  partner  ShippingPartner @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  shipment Shipment?       @relation(fields: [shipment_id], references: [id], onDelete: SetNull)

  @@index([awb_number], map: "idx_awb_numbers_awb_number")
  @@index([shipment_id], map: "idx_awb_numbers_shipment_id")
  @@index([status], map: "idx_awb_numbers_status")
  @@map("awb_numbers")
}

model ShipmentLabel {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id   String              @db.Uuid
  package_id    String?             @db.Uuid
  media_file_id String?             @db.Uuid
  label_url     String?             @db.VarChar(1024)
  label_format  ShippingLabelFormat @default(pdf)
  generated_at  DateTime            @default(now()) @db.Timestamptz(6)
  status        RecordStatus        @default(active)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?           @db.Timestamptz(6)
  created_by    String?             @db.Uuid
  updated_by    String?             @db.Uuid

  shipment   Shipment         @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  package    ShipmentPackage? @relation(fields: [package_id], references: [id], onDelete: SetNull)
  media_file MediaFile?       @relation(fields: [media_file_id], references: [id], onDelete: SetNull)

  @@index([shipment_id], map: "idx_shipment_labels_shipment_id")
  @@map("shipment_labels")
}

model ShipmentTracking {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id    String         @unique @db.Uuid
  current_status ShipmentStatus @default(created)
  last_location  String?        @db.VarChar(255)
  last_event_at  DateTime?      @db.Timestamptz(6)
  exception_code String?        @db.VarChar(64)
  exception_note String?        @db.Text
  raw_snapshot   Json?
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?      @db.Timestamptz(6)
  created_by     String?        @db.Uuid
  updated_by     String?        @db.Uuid

  shipment Shipment        @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  events   TrackingEvent[]

  @@index([current_status], map: "idx_shipment_tracking_status")
  @@map("shipment_tracking")
}

model TrackingEvent {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id    String         @db.Uuid
  tracking_id    String?        @db.Uuid
  event_status   ShipmentStatus
  event_code     String?        @db.VarChar(64)
  description    String?        @db.Text
  location       String?        @db.VarChar(255)
  exception_code String?        @db.VarChar(64)
  occurred_at    DateTime       @default(now()) @db.Timestamptz(6)
  raw_payload    Json?
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?      @db.Timestamptz(6)
  created_by     String?        @db.Uuid
  updated_by     String?        @db.Uuid

  shipment Shipment          @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  tracking ShipmentTracking? @relation(fields: [tracking_id], references: [id], onDelete: SetNull)

  @@index([shipment_id], map: "idx_tracking_events_shipment_id")
  @@index([event_status], map: "idx_tracking_events_status")
  @@map("tracking_events")
}

model DeliveryAttempt {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id        String                 @db.Uuid
  attempt_number     Int
  status             DeliveryAttemptStatus
  failure_reason     String?                @db.VarChar(255)
  failure_reason_id  String?                @db.Uuid
  exception_code     String?                @db.VarChar(64)
  attempted_at       DateTime               @default(now()) @db.Timestamptz(6)
  notes              String?                @db.Text
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  updated_at         DateTime               @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?              @db.Timestamptz(6)
  created_by         String?                @db.Uuid
  updated_by         String?                @db.Uuid

  shipment              Shipment                @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  delivery_failure_reason DeliveryFailureReason? @relation(fields: [failure_reason_id], references: [id], onDelete: SetNull)

  @@index([shipment_id], map: "idx_delivery_attempts_shipment_id")
  @@index([failure_reason_id], map: "idx_delivery_attempts_failure_reason_id")
  @@map("delivery_attempts")
}

model DeliveryProof {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id       String    @db.Uuid
  receiver_name     String    @db.VarChar(160)
  signature_file_id String?   @db.Uuid
  photo_file_id     String?   @db.Uuid
  otp_verified      Boolean   @default(false)
  otp_reference     String?   @db.VarChar(64)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  delivered_at      DateTime  @default(now()) @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid

  shipment  Shipment   @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  signature MediaFile? @relation("DeliverySignature", fields: [signature_file_id], references: [id], onDelete: SetNull)
  photo     MediaFile? @relation("DeliveryPhoto", fields: [photo_file_id], references: [id], onDelete: SetNull)

  @@index([shipment_id], map: "idx_delivery_proofs_shipment_id")
  @@map("delivery_proofs")
}

model ReverseShipment {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reverse_number      String                 @db.VarChar(64)
  reverse_type        ReverseShipmentType
  order_id            String                 @db.Uuid
  return_id           String?                @db.Uuid
  exchange_request_id String?                @db.Uuid
  warehouse_id        String                 @db.Uuid
  partner_id          String                 @db.Uuid
  service_id          String?                @db.Uuid
  shipment_id         String?                @db.Uuid
  tracking_number     String?                @db.VarChar(128)
  awb_number          String?                @db.VarChar(128)
  status              ReverseShipmentStatus  @default(requested)
  requested_at        DateTime               @default(now()) @db.Timestamptz(6)
  picked_up_at        DateTime?              @db.Timestamptz(6)
  received_at         DateTime?              @db.Timestamptz(6)
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  updated_at          DateTime               @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?              @db.Timestamptz(6)
  created_by          String?                @db.Uuid
  updated_by          String?                @db.Uuid

  order            Order            @relation(fields: [order_id], references: [id], onDelete: Restrict)
  return_row       Return?          @relation(fields: [return_id], references: [id], onDelete: SetNull)
  exchange_request ExchangeRequest? @relation(fields: [exchange_request_id], references: [id], onDelete: SetNull)
  warehouse        Warehouse        @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  partner          ShippingPartner  @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  service          ShippingService? @relation(fields: [service_id], references: [id], onDelete: SetNull)
  shipment         Shipment?        @relation(fields: [shipment_id], references: [id], onDelete: SetNull)
  rto_shipments    RtoShipment[]

  @@index([order_id], map: "idx_reverse_shipments_order_id")
  @@index([status], map: "idx_reverse_shipments_status")
  @@index([tracking_number], map: "idx_reverse_shipments_tracking_number")
  @@index([awb_number], map: "idx_reverse_shipments_awb_number")
  @@map("reverse_shipments")
}

model RtoShipment {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  forward_shipment_id String         @db.Uuid
  reverse_shipment_id String?        @db.Uuid
  warehouse_id        String         @db.Uuid
  partner_id          String         @db.Uuid
  reason              String?        @db.VarChar(255)
  tracking_number     String?        @db.VarChar(128)
  awb_number          String?        @db.VarChar(128)
  status              RtoStatus      @default(initiated)
  initiated_at        DateTime       @default(now()) @db.Timestamptz(6)
  received_at         DateTime?      @db.Timestamptz(6)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?      @db.Timestamptz(6)
  created_by          String?        @db.Uuid
  updated_by          String?        @db.Uuid

  forward_shipment Shipment         @relation("RtoForwardShipment", fields: [forward_shipment_id], references: [id], onDelete: Restrict)
  reverse_shipment ReverseShipment? @relation(fields: [reverse_shipment_id], references: [id], onDelete: SetNull)
  warehouse        Warehouse        @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  partner          ShippingPartner  @relation(fields: [partner_id], references: [id], onDelete: Restrict)

  @@index([forward_shipment_id], map: "idx_rto_shipments_forward_shipment_id")
  @@index([status], map: "idx_rto_shipments_status")
