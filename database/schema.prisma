  updated_at  DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)
  created_by  String?      @db.Uuid
  updated_by  String?      @db.Uuid

  live_metrics LiveMetric[]

  @@map("metric_streams")
}

model LiveMetric {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stream_id    String   @db.Uuid
  metric_key   String   @db.VarChar(120)
  metric_value Decimal  @db.Decimal(18, 4)
  dimensions   Json?
  observed_at  DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  stream MetricStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@index([stream_id], map: "idx_live_metrics_stream_id")
  @@map("live_metrics")
}

model AlertRule {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String        @db.VarChar(64)
  name             String        @db.VarChar(160)
  severity         AlertSeverity @default(warning)
  condition_json   Json
  cooldown_minutes Int           @default(15)
  is_enabled       Boolean       @default(true)
  status           RecordStatus  @default(active)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  created_by       String?       @db.Uuid
  updated_by       String?       @db.Uuid

  notifications AlertNotification[]
  history       AlertHistory[]

  @@map("alert_rules")
}

model AlertNotification {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id    String       @db.Uuid
  channel    String       @db.VarChar(32)
  target     String       @db.VarChar(320)
  status     RecordStatus @default(active)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?    @db.Timestamptz(6)
  created_by String?      @db.Uuid
  updated_by String?      @db.Uuid

  rule AlertRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id], map: "idx_alert_notifications_rule_id")
  @@map("alert_notifications")
}

model AlertHistory {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id         String        @db.Uuid
  severity        AlertSeverity
  message         String        @db.Text
  payload         Json?
  triggered_at    DateTime      @default(now()) @db.Timestamptz(6)
  acknowledged_at DateTime?     @db.Timestamptz(6)
  acknowledged_by String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)

  rule         AlertRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  acknowledger User?     @relation("AlertAcknowledgements", fields: [acknowledged_by], references: [id], onDelete: SetNull)

  @@index([rule_id], map: "idx_alert_history_rule_id")
  @@index([acknowledged_by], map: "idx_alert_history_acknowledged_by")
  @@map("alert_history")
}

model ExperimentMetric {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
