model Warehouse {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String       @db.VarChar(160)
  code             String       @db.VarChar(32)
  address          String?      @db.VarChar(512)
  city             String?      @db.VarChar(100)
  state            String?      @db.VarChar(100)
  country          String?      @db.VarChar(100)
  postal_code      String?      @db.VarChar(20)
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  manager_user_id  String?      @db.Uuid
  status           RecordStatus @default(active)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  created_by       String?      @db.Uuid
  updated_by       String?      @db.Uuid

  manager              User?                @relation("WarehouseManager", fields: [manager_user_id], references: [id], onDelete: SetNull)
  zones                WarehouseZone[]
  inventory_rows       Inventory[]
  inventory_batches    InventoryBatch[]
  inventory_movements  InventoryMovement[]
  stock_reservations   StockReservation[]
  serial_numbers       SerialNumber[]
  purchase_orders      PurchaseOrder[]
  goods_receipts       GoodsReceipt[]
  transfers_from       StockTransfer[]      @relation("TransferFrom")
  transfers_to         StockTransfer[]      @relation("TransferTo")
  inventory_adjustments InventoryAdjustment[]
  low_stock_alerts     LowStockAlert[]
  return_to_stock_rows ReturnToStock[]
  warehouse_capacity   WarehouseCapacity?
  cycle_count_jobs     CycleCountJob[]
  preferred_orders     Order[] @relation("OrderFulfillmentWarehouse")
  fulfillment_orders   FulfillmentOrder[]
  shipping_rules       ShippingRule[]
  pickup_schedules     PickupSchedule[]
  pickup_requests      PickupRequest[]
  shipments            Shipment[]
  reverse_shipments    ReverseShipment[]
  rto_shipments        RtoShipment[]
  service_center_locations ServiceCenterLocation[]
  repair_parts             RepairPart[]
  repair_part_usage        RepairPartUsage[]
  loan_devices             LoanDevice[]
  inventory_metrics        InventoryMetrics[]

  @@map("warehouses")
}

/// warehouse → zone → rack → bin → inventory
model WarehouseZone {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouse_id String       @db.Uuid
  code         String       @db.VarChar(32)
  name         String?      @db.VarChar(120)
  status       RecordStatus @default(active)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)
  created_by   String?      @db.Uuid
  updated_by   String?      @db.Uuid

  warehouse Warehouse       @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  racks     WarehouseRack[]

  @@index([warehouse_id], map: "idx_warehouse_zones_warehouse_id")
  @@map("warehouse_zones")
}

model WarehouseRack {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_id    String       @db.Uuid
  code       String       @db.VarChar(32)
  status     RecordStatus @default(active)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?    @db.Timestamptz(6)
  created_by String?      @db.Uuid
  updated_by String?      @db.Uuid

  zone WarehouseZone  @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  bins WarehouseBin[]

  @@index([zone_id], map: "idx_warehouse_racks_zone_id")
  @@map("warehouse_racks")
}

model WarehouseBin {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
