model Cart {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?    @db.Uuid
  session_key    String?    @db.VarChar(64)
  currency       String     @default("INR") @db.VarChar(3)
  merged_into_id String?    @db.Uuid
  status         CartStatus @default(active)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?  @db.Timestamptz(6)
  created_by     String?    @db.Uuid
  updated_by     String?    @db.Uuid

  user               User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  merged_into        Cart?              @relation("CartMerge", fields: [merged_into_id], references: [id], onDelete: SetNull)
  merged_from        Cart[]             @relation("CartMerge")
  items              CartItem[]
  saved_for_later    SavedForLater[]
  stock_reservations StockReservation[]
  orders                    Order[]
  cart_abandonment_events   CartAbandonmentEvent[]

  @@index([user_id], map: "idx_carts_user_id")
  @@index([session_key], map: "idx_carts_session_key")
  @@index([status], map: "idx_carts_status")
  @@map("carts")
}

