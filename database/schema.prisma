// Electronics Cart — PostgreSQL 16 + Prisma
// Phases 1–9 APPROVED / LOCKED — Database v1.0 (+ 046 enum naming guard)
// Deployment: SQL-first (database/sql/001–046); Prisma enums @@map to snake_case SQL types

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// PHASE 1 — AUTHENTICATION ENUMS
// ─────────────────────────────────────────────

enum RecordStatus {
  active
  inactive
  suspended
  pending
  archived

  @@map("record_status")

}

enum UserType {
  customer
  admin
  vendor
  technician
  support
  system

  @@map("user_type")

}

enum AuthProvider {
  local
  google
  apple
  otp

  @@map("auth_provider")

}

enum OtpPurpose {
  login
  register
  reset_password
  verify_email
  verify_mobile
  two_factor

  @@map("otp_purpose")

}

enum OtpChannel {
  sms
  email
  whatsapp

  @@map("otp_channel")

}

enum SessionStatus {
  active
  revoked
  expired

  @@map("session_status")

}

enum TokenStatus {
  active
  rotated
  revoked
  expired

  @@map("token_status")

}

// ─────────────────────────────────────────────
// PHASE 1 — AUTHENTICATION MODELS
// ─────────────────────────────────────────────

/// Core identity. Profile fields stay thin; customer profile lands in Phase 1b/Customer.
model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?      @db.VarChar(320)
  mobile           String?      @db.VarChar(20)
  password_hash    String?      @db.VarChar(255)
  email_verified_at DateTime?   @db.Timestamptz(6)
  mobile_verified_at DateTime?  @db.Timestamptz(6)
  user_type        UserType     @default(customer)
  auth_provider    AuthProvider @default(local)
  last_login_at    DateTime?    @db.Timestamptz(6)
  last_login_ip    String?      @db.VarChar(45)
  failed_login_count Int        @default(0)
  locked_until     DateTime?    @db.Timestamptz(6)
  mfa_enabled      Boolean      @default(false)
  mfa_secret       String?      @db.VarChar(255)
  status           RecordStatus @default(pending)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  created_by       String?      @db.Uuid
  updated_by       String?      @db.Uuid

  roles            UserRole[]
  refresh_tokens   RefreshToken[]
  sessions         Session[]
  otps             Otp[]
  oauth_accounts   OauthAccount[]
  login_attempts   LoginAttempt[]
  product_reviews  ProductReview[]
  compare_products CompareProduct[]
  managed_warehouses Warehouse[] @relation("WarehouseManager")
  carts              Cart[]
  wishlists          Wishlist[]
  orders             Order[]     @relation("CustomerOrders")
  coupon_usages      CouponUsage[]
  order_notes_authored OrderNote[] @relation("OrderNoteAuthor")
  wallet             Wallet?
  store_credits      StoreCredit[]
  gift_cards_purchased GiftCard[] @relation("GiftCardPurchaser")
  payments             Payment[]  @relation("CustomerPayments")
  payment_attempts     PaymentAttempt[]
  refunds_requested    Refund[]   @relation("RefundRequester")
  wallet_redemptions   WalletRedemption[]
  gift_card_redemptions GiftCardRedemption[]
  payment_disputes     PaymentDispute[]
  saved_payment_methods SavedPaymentMethod[]
  merchant_accounts    MerchantAccount[] @relation("VendorMerchantAccounts")
  warranty_registrations WarrantyRegistration[] @relation("WarrantyRegistrationCustomer")
  warranty_claims        WarrantyClaim[]        @relation("WarrantyClaimCustomer")
  technician_profiles    Technician[]
  service_tickets        ServiceTicket[]        @relation("ServiceTicketCustomer")
  replacement_requests   ReplacementRequest[]   @relation("ReplacementRequestCustomer")
  rma_requests           RmaRequest[]           @relation("RmaRequestCustomer")
  trade_in_requests      TradeInRequest[]       @relation("TradeInRequestCustomer")
  service_feedback       ServiceFeedback[]      @relation("ServiceFeedbackCustomer")
  service_contracts      ServiceContract[]      @relation("ServiceContractCustomer")
  loan_allocations       LoanAllocation[]       @relation("LoanAllocationCustomer")
  newsletter_subscriptions   NewsletterSubscriber[]
  blogs_authored             Blog[]                 @relation("BlogAuthor")
  buying_guides_authored     BuyingGuide[]          @relation("BuyingGuideAuthor")
  blog_comments              BlogComment[]
  referral_rewards_as_referrer ReferralReward[]     @relation("ReferralReferrer")
  referral_rewards_as_referee  ReferralReward[]     @relation("ReferralReferee")
  loyalty_account            LoyaltyAccount?
  segment_memberships        CustomerSegmentMember[]
  recently_viewed            RecentlyViewedProduct[]
  recommendation_impressions RecommendationImpression[]
  recommendation_clicks      RecommendationClick[]
  recommendation_feedback    RecommendationFeedback[]
  campaign_attributions      CampaignAttribution[]
  audit_logs_performed       AuditLog[]             @relation("AuditLogPerformer")
  activity_logs              ActivityLog[]
  user_events                UserEvent[]
  page_views                 PageView[]
  screen_views               ScreenView[]
  session_analytics          SessionAnalytics[]
  search_logs                SearchLog[]
  conversion_events          ConversionEvent[]
  cart_abandonment_events    CartAbandonmentEvent[]
  analytics_product_views    ProductView[]
  error_logs                 ErrorLog[]
  api_request_logs           ApiRequestLog[]
  saved_reports_owned        SavedReport[]          @relation("SavedReportOwner")
  report_exports_requested   ReportExport[]         @relation("ReportExportRequester")
  customer_ltv               CustomerLtv[]
  alert_acknowledgements     AlertHistory[]         @relation("AlertAcknowledgements")

  created_users    User[]       @relation("UserCreatedBy")
  updated_users    User[]       @relation("UserUpdatedBy")
  creator          User?        @relation("UserCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updater          User?        @relation("UserUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@unique([email], map: "uq_users_email")
  @@unique([mobile], map: "uq_users_mobile")
  @@index([status], map: "idx_users_status")
  @@index([user_type], map: "idx_users_user_type")
  @@index([deleted_at], map: "idx_users_deleted_at")
  @@index([created_at], map: "idx_users_created_at")
  @@map("users")
}

model Role {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @db.VarChar(64)
  name        String       @db.VarChar(120)
  description String?      @db.Text
  is_system   Boolean      @default(false)
  status      RecordStatus @default(active)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)
  created_by  String?      @db.Uuid
  updated_by  String?      @db.Uuid

  permissions RolePermission[]
  users       UserRole[]

  @@unique([code], map: "uq_roles_code")
  @@index([status], map: "idx_roles_status")
  @@index([deleted_at], map: "idx_roles_deleted_at")
  @@map("roles")
}

model Permission {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @db.VarChar(120)
  module      String       @db.VarChar(64)
  action      String       @db.VarChar(64)
  description String?      @db.Text
  status      RecordStatus @default(active)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)
  created_by  String?      @db.Uuid
  updated_by  String?      @db.Uuid

  roles RolePermission[]

  @@unique([code], map: "uq_permissions_code")
  @@unique([module, action], map: "uq_permissions_module_action")
  @@index([module], map: "idx_permissions_module")
  @@index([deleted_at], map: "idx_permissions_deleted_at")
  @@map("permissions")
}

model RolePermission {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String       @db.Uuid
  permission_id String       @db.Uuid
  status        RecordStatus @default(active)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?    @db.Timestamptz(6)
  created_by    String?      @db.Uuid
  updated_by    String?      @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id], map: "uq_role_permissions_role_permission")
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model UserRole {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String       @db.Uuid
  role_id    String       @db.Uuid
  status     RecordStatus @default(active)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?    @db.Timestamptz(6)
  created_by String?      @db.Uuid
  updated_by String?      @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([user_id, role_id], map: "uq_user_roles_user_role")
  @@index([role_id], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model RefreshToken {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String      @db.Uuid
  token_hash      String      @db.VarChar(128)
  family_id       String      @db.Uuid
  replaced_by_id  String?     @db.Uuid
  user_agent      String?     @db.VarChar(512)
  ip_address      String?     @db.VarChar(45)
  expires_at      DateTime    @db.Timestamptz(6)
  revoked_at      DateTime?   @db.Timestamptz(6)
  status          TokenStatus @default(active)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?   @db.Timestamptz(6)
  created_by      String?     @db.Uuid
  updated_by      String?     @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([token_hash], map: "uq_refresh_tokens_token_hash")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([family_id], map: "idx_refresh_tokens_family_id")
  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
  @@index([status], map: "idx_refresh_tokens_status")
  @@map("refresh_tokens")
}

model Session {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String        @db.Uuid
  session_token_hash String     @db.VarChar(128)
  device_name     String?       @db.VarChar(120)
  device_type     String?       @db.VarChar(64)
  user_agent      String?       @db.VarChar(512)
  ip_address      String?       @db.VarChar(45)
  last_seen_at    DateTime      @default(now()) @db.Timestamptz(6)
  expires_at      DateTime      @db.Timestamptz(6)
  revoked_at      DateTime?     @db.Timestamptz(6)
  status          SessionStatus @default(active)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?     @db.Timestamptz(6)
  created_by      String?       @db.Uuid
  updated_by      String?       @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([session_token_hash], map: "uq_sessions_token_hash")
  @@index([user_id], map: "idx_sessions_user_id")
  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([status], map: "idx_sessions_status")
  @@map("sessions")
}

model Otp {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?      @db.Uuid
  destination  String       @db.VarChar(255)
  channel      OtpChannel
  purpose      OtpPurpose
  code_hash    String       @db.VarChar(128)
  attempts     Int          @default(0)
  max_attempts Int          @default(5)
  expires_at   DateTime     @db.Timestamptz(6)
  consumed_at  DateTime?    @db.Timestamptz(6)
  status       RecordStatus @default(active)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)
  created_by   String?      @db.Uuid
  updated_by   String?      @db.Uuid

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([destination, purpose], map: "idx_otps_destination_purpose")
  @@index([user_id], map: "idx_otps_user_id")
  @@index([expires_at], map: "idx_otps_expires_at")
  @@index([status], map: "idx_otps_status")
  @@map("otps")
}

model OauthAccount {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String       @db.Uuid
  provider          AuthProvider
  provider_user_id  String       @db.VarChar(255)
  email             String?      @db.VarChar(320)
  access_token_enc  String?      @db.Text
  refresh_token_enc String?      @db.Text
  token_expires_at  DateTime?    @db.Timestamptz(6)
  raw_profile       Json?
  status            RecordStatus @default(active)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)
  created_by        String?      @db.Uuid
  updated_by        String?      @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id], map: "uq_oauth_accounts_provider_user")
  @@index([user_id], map: "idx_oauth_accounts_user_id")
  @@index([email], map: "idx_oauth_accounts_email")
  @@map("oauth_accounts")
}

model LoginAttempt {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?   @db.Uuid
  identifier   String    @db.VarChar(255)
  ip_address   String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(512)
  success      Boolean   @default(false)
  failure_reason String? @db.VarChar(120)
  status       RecordStatus @default(active)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  created_by   String?   @db.Uuid
  updated_by   String?   @db.Uuid

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([identifier, created_at], map: "idx_login_attempts_identifier_created")
  @@index([ip_address, created_at], map: "idx_login_attempts_ip_created")
  @@index([user_id], map: "idx_login_attempts_user_id")
  @@map("login_attempts")
}

// ─────────────────────────────────────────────
// PHASE 2 — CATALOG ENUMS
// ─────────────────────────────────────────────

enum StockStatus {
  in_stock
  out_of_stock
  preorder
  discontinued
  made_to_order

  @@map("stock_status")

}

enum ProductCondition {
  new_sealed
  like_new
  excellent
  good
  fair
  open_box
  refurbished
  certified_refurbished

  @@map("product_condition")

}

enum ProductGrade {
  a_plus
  a
  b
  c
  ungraded

  @@map("product_grade")

}

enum MediaKind {
  image
  video
  document
  other

  @@map("media_kind")

}

enum RelatedProductType {
  cross_sell
  upsell
  frequently_bought_together
  accessory
  alternative

  @@map("related_product_type")

}

enum AttributeDataType {
  string
  number
  boolean
  enum_value

  @@map("attribute_data_type")

}

// ─────────────────────────────────────────────
// PHASE 2 — CATALOG MODELS
// ─────────────────────────────────────────────

/// S3 / CDN object registry — brands, categories, and product media reference this.
model MediaFile {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket        String       @db.VarChar(120)
  object_key    String       @db.VarChar(512)
  mime_type     String       @db.VarChar(120)
  byte_size     BigInt       @default(0)
  checksum      String?      @db.VarChar(128)
  width         Int?
  height        Int?
  duration_ms   Int?
  kind          MediaKind    @default(image)
  original_name String?      @db.VarChar(255)
  status        RecordStatus @default(active)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?    @db.Timestamptz(6)
  created_by    String?      @db.Uuid
  updated_by    String?      @db.Uuid

  brand_logos       Brand[]           @relation("BrandLogo")
  category_icons    Category[]        @relation("CategoryIcon")
  category_banners  Category[]        @relation("CategoryBanner")
  product_images    ProductImage[]
  product_media     ProductMedia[]
  product_documents ProductDocument[]
  review_images     ReviewImage[]
  invoice_documents InvoiceDocument[]
  shipment_labels   ShipmentLabel[]
  delivery_signatures DeliveryProof[] @relation("DeliverySignature")
  delivery_photos     DeliveryProof[] @relation("DeliveryPhoto")
  claim_documents     ClaimDocument[]
  service_documents   ServiceDocument[]
  banner_desktop      Banner[]      @relation("BannerDesktop")
  banner_mobile       Banner[]      @relation("BannerMobile")
  collection_media    Collection[]
  blog_covers         Blog[]
  buying_guide_covers BuyingGuide[]
  seo_og_images       SeoMetadata[]
  report_exports      ReportExport[]
  warehouse_exports   WarehouseExport[]

  @@unique([bucket, object_key], map: "uq_media_files_bucket_key")
  @@index([kind], map: "idx_media_files_kind")
  @@index([deleted_at], map: "idx_media_files_deleted_at")
  @@map("media_files")
}

model Brand {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @db.VarChar(120)
  slug         String       @db.VarChar(160)
  logo_file_id String?      @db.Uuid
  description  String?      @db.Text
  country      String?      @db.VarChar(80)
  website      String?      @db.VarChar(255)
  sort_order   Int          @default(0)
  status       RecordStatus @default(active)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)
  created_by   String?      @db.Uuid
  updated_by   String?      @db.Uuid

  logo     MediaFile? @relation("BrandLogo", fields: [logo_file_id], references: [id], onDelete: SetNull)
  products Product[]
  coupon_rules CouponRule[]

  @@index([status], map: "idx_brands_status")
  @@index([sort_order], map: "idx_brands_sort_order")
  @@map("brands")
}

/// Unlimited nesting via parent_id (subcategory = child row).
model Category {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id      String?      @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(160)
  icon_file_id   String?      @db.Uuid
  banner_file_id String?      @db.Uuid
  description    String?      @db.Text
  sort_order     Int          @default(0)
  status         RecordStatus @default(active)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?    @db.Timestamptz(6)
  created_by     String?      @db.Uuid
  updated_by     String?      @db.Uuid

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  icon     MediaFile? @relation("CategoryIcon", fields: [icon_file_id], references: [id], onDelete: SetNull)
  banner   MediaFile? @relation("CategoryBanner", fields: [banner_file_id], references: [id], onDelete: SetNull)
  products Product[]
  coupon_rules CouponRule[]

  @@index([parent_id], map: "idx_categories_parent_id")
  @@index([status], map: "idx_categories_status")
  @@index([sort_order], map: "idx_categories_sort_order")
  @@map("categories")
}

model ProductType {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @db.VarChar(64)
  name        String       @db.VarChar(120)
  description String?      @db.Text
  status      RecordStatus @default(active)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)
  created_by  String?      @db.Uuid
  updated_by  String?      @db.Uuid

  products Product[]

  @@map("product_types")
}

model Product {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id          String       @db.Uuid
  category_id       String       @db.Uuid
  product_type_id   String       @db.Uuid
  name              String       @db.VarChar(255)
  slug              String       @db.VarChar(280)
  short_description String?      @db.VarChar(512)
  description       String?      @db.Text
  seo_title         String?      @db.VarChar(180)
  seo_description   String?      @db.VarChar(320)
  meta_keywords     String?      @db.VarChar(512)
  canonical_url     String?      @db.VarChar(512)
  is_featured       Boolean      @default(false)
  is_refurbished    Boolean      @default(false)
  is_open_box       Boolean      @default(false)
  is_new_arrival    Boolean      @default(false)
  rating_avg        Decimal      @default(0) @db.Decimal(3, 2)
  review_count      Int          @default(0)
  status            RecordStatus @default(active)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)
  created_by        String?      @db.Uuid
  updated_by        String?      @db.Uuid

  brand        Brand       @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category     Category    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  product_type ProductType @relation(fields: [product_type_id], references: [id], onDelete: Restrict)

  variants       ProductVariant[]
  images         ProductImage[]
  media          ProductMedia[]
  documents      ProductDocument[]
  specifications ProductSpecification[]
  tag_maps       TagMap[]
  reviews        ProductReview[]
  featured_slots FeaturedProduct[]
  compare_entries CompareProduct[]
  related_from   RelatedProduct[] @relation("RelatedFrom")
  related_to     RelatedProduct[] @relation("RelatedTo")
  collection_products  CollectionProduct[]
  badge_assignments    ProductBadgeAssignment[]
  recommendations_from           ProductRecommendation[]  @relation("RecommendationsFrom")
  recommendations_to             ProductRecommendation[]  @relation("RecommendationsTo")
  recently_viewed                RecentlyViewedProduct[]
  recommendation_impressions_from RecommendationImpression[] @relation("RecommendationImpressionsFrom")
  recommendation_impressions_to   RecommendationImpression[] @relation("RecommendationImpressionsTo")
  recommendation_clicks_from      RecommendationClick[]      @relation("RecommendationClicksFrom")
