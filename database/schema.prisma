  draft
  published
  archived

  @@map("content_version_status")
}

model AbTest {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @db.VarChar(64)
  name        String       @db.VarChar(160)
