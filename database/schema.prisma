enum CartStatus {
  active
  merged
  converted
  abandoned

  @@map("cart_status")

}

enum CouponDiscountType {
  flat
  percentage

  @@map("coupon_discount_type")

}

enum CouponRuleType {
  brand
  category
  min_cart_value
  max_discount
  usage_limit
  per_user_limit

  @@map("coupon_rule_type")

}

enum OrderStatus {
  pending
  confirmed
  processing
  packed
  shipped
  delivered
  completed
  cancelled
  returned
  refunded

  @@map("order_status")

}

enum AddressType {
  shipping
  billing

  @@map("address_type")

}

enum OrderNoteVisibility {
  internal
  customer

  @@map("order_note_visibility")

}

enum InvoiceStatus {
  draft
  issued
  cancelled
  credited

  @@map("invoice_status")

}

enum ReturnStatus {
  requested
  approved
  rejected
  picked_up
  received
  inspection
  refunded
  completed

  @@map("return_status")

}

enum ExchangeType {
  same_variant
  different_variant
  store_credit

  @@map("exchange_type")

}

enum ExchangeStatus {
  requested
  approved
  rejected
  fulfilled
  cancelled

  @@map("exchange_status")

}

enum OrderEventType {
  created
  status_changed
  payment_update
  shipment_update
  note_added
  coupon_applied
  cancelled
  return_requested
  exchange_requested
  invoice_issued
  other

  @@map("order_event_type")

}

