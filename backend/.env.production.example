# Electronics Cart — Production environment (placeholders only)
# Copy to .env on the server and fill every blank. Never commit real values.

NODE_ENV=production
APP_ENV=production
APP_NAME=Electronics Cart API
PORT=3051
API_PREFIX=api
CORS_ORIGINS=https://www.example.com,https://admin.example.com

PROCESS_ROLE=api
DISABLE_WORKERS=false

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/electronics_cart
DIRECT_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/electronics_cart
PRISMA_CONNECTION_LIMIT=20
PRISMA_POOL_TIMEOUT=10

REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0
REDIS_KEY_PREFIX=ec:
REDIS_DEFAULT_TTL_SECONDS=300

JWT_SECRET=REPLACE_WITH_32+_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32+_CHAR_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TRUST_PROXY=true
ENFORCE_ADMIN_IP_ALLOWLIST=true
ADMIN_IP_ALLOWLIST=10.0.0.0/8
HSTS_MAX_AGE_SECONDS=31536000
HIDE_ERROR_DETAILS=true

LOG_LEVEL=info

SWAGGER_ENABLED=false
SWAGGER_PATH=docs

STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="Electronics Cart <noreply@example.com>"

QUEUE_PREFIX=ec:queue
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=2000

PAYMENTS_MOCK=false
PAYMENTS_DEFAULT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPPING_MOCK=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=30
THROTTLE_OTP_LIMIT=10
THROTTLE_PAYMENT_LIMIT=40
THROTTLE_ADMIN_LIMIT=60
THROTTLE_UPLOAD_LIMIT=20

BACKUP_RETENTION_DAYS=14
