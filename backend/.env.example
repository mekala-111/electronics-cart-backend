# Electronics Cart — Backend environment (copy to .env)
# Database schema is locked in ../database — do not migrate from this app.

NODE_ENV=development
APP_ENV=development
APP_NAME=Electronics Cart API
# Firebase project used to verify Google / phone ID tokens (POST /auth/firebase)
FIREBASE_PROJECT_ID=electronics-cart
PORT=3051
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Process role: api | worker
PROCESS_ROLE=api
DISABLE_WORKERS=false

# PostgreSQL (v1.0 locked schema)
DATABASE_URL=postgresql://electronics:electronics@127.0.0.1:5433/electronics_cart
DIRECT_URL=postgresql://electronics:electronics@127.0.0.1:5433/electronics_cart
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10
POSTGRES_USER=electronics
POSTGRES_PASSWORD=electronics
POSTGRES_DB=electronics_cart

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=ec:
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_MAXMEMORY=512mb

# JWT (foundation only — replace secrets before staging/prod; prod requires ≥32 chars)
JWT_SECRET=dev-access-secret-change-me-please-use-long
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
TRUST_PROXY=false
ENFORCE_ADMIN_IP_ALLOWLIST=false
ADMIN_IP_ALLOWLIST=
HSTS_MAX_AGE_SECONDS=31536000
HIDE_ERROR_DETAILS=false

# Logging
LOG_LEVEL=debug

# Swagger (must be false in production)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Storage (local | s3) — MinIO / AWS S3 compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# SMTP / Mail (queued delivery via BullMQ email queue)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Electronics Cart <noreply@electronicscart.local>"

# Queue (BullMQ)
QUEUE_PREFIX=ec:queue
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=2000

# Payments (mock=true when keys empty; must be false in production)
# Storefront has no Razorpay Checkout.js — server capture settles checkout (default true).
# Set PAYMENTS_SERVER_CAPTURE=false only after wiring hosted/embedded Razorpay.
PAYMENTS_MOCK=true
PAYMENTS_SERVER_CAPTURE=true
PAYMENTS_DEFAULT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping
SHIPPING_MOCK=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

# Rate limit (Redis-backed)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=30
THROTTLE_OTP_LIMIT=10
THROTTLE_PAYMENT_LIMIT=40
THROTTLE_ADMIN_LIMIT=60
THROTTLE_UPLOAD_LIMIT=20

# Backups
BACKUP_RETENTION_DAYS=14
# AGE_RECIPIENT=age1...
