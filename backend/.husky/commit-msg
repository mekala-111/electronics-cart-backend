#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh" 2>/dev/null || true
# Conventional Commits: type(scope)?: subject
msg="$(cat "$1")"
echo "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+' || {
  echo "Commit message must follow Conventional Commits (e.g. feat: add health module)"
  exit 1
}
